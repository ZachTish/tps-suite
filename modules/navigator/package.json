{
  "name": "tps-notebook-navigator",
  "version": "8.4.0",
  "description": "Experimental, co-installable TPS fork of Notebook Navigator with optional TPS integrations.",
  "main": "main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/build-icons.mjs && node scripts/build-styles.mjs && node esbuild.config.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "check:strings": "node scripts/check-unused-strings.mjs --check",
    "build": "node scripts/build-styles.mjs && npm run check:strings && tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "lint:styles": "npm run build:styles && stylelint \"src/styles/**/*.css\" \"styles.css\" --max-warnings=0",
    "tps:namespace": "node scripts/tps-namespace.mjs --write",
    "tps:namespace:check": "node scripts/tps-namespace.mjs --check",
    "tps:artifacts:check": "node scripts/check-tps-artifacts.mjs",
    "tps:operational-identity:check": "node scripts/check-tps-operational-identity.mjs",
    "upstream:audit": "node scripts/upstream-merge-audit.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "obsidian",
    "tps",
    "navigator"
  ],
  "author": "Zach Tish; based on Notebook Navigator by Johan Sanneblad",
  "license": "LicenseRef-NotebookNavigator",
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "knip": "^6.32.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.10",
    "emoji-regex-xs": "^2.0.1",
    "emojilib": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
